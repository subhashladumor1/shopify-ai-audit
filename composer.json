{
    "name": "subhash/shopify-ai-audit",
    "description": "AI-powered Shopify Security, Compliance, API Intelligence, Performance Auditing, Observability and Remediation for Laravel applications.",
    "keywords": [
        "laravel",
        "shopify",
        "security",
        "audit",
        "compliance",
        "app-store",
        "api-intelligence",
        "observability",
        "remediation",
        "ai-agents"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Subhash Ladumor",
            "homepage": "https://github.com/subhashladumor1"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/database": "^11.0 || ^12.0",
        "illuminate/events": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/routing": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/view": "^11.0 || ^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Subhash\\ShopifyAiAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Subhash\\ShopifyAiAudit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Subhash\\ShopifyAiAudit\\ShopifyAiAuditServiceProvider"
            ],
            "aliases": {
                "Guardian": "Subhash\\ShopifyAiAudit\\Facades\\Guardian"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
